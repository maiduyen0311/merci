{%- comment -%}
  Merci layered art — the visual half of every Merci banner (SPEC Appendix E).
  Built from live layers instead of one flat picture, so text stays editable/translatable
  and the composition adapts to any photo:
    word     huge outlined word behind everything (cropped by the box)
    blob     soft colour disc that slowly breathes
    dots     dotted patch (pattern, no image)
    frame    the photo, clipped to an arch / circle / rectangle
    outline  thin line repeating the frame shape, offset
    badge    round text stamp that slowly rotates, arrow in the middle
    sticker  tilted pill ("-30%", "New in")
    caption  small vertical caption ("SS — 2026")
  Hover (pointer devices): layers drift at different depths (assets via mc-art.js).

  Accepts:
  - image {Image} photo (falls back to a placeholder)
  - shape {String} 'arch' (default) | 'circle' | 'rect'
  - word {String} outlined background word
  - badge {String} text running around the stamp (blank = no stamp)
  - badge_url {String} optional link for the stamp
  - sticker {String} tilted pill text
  - caption {String} vertical caption
  - size {String} 'lg' (default) | 'md' | 'sm'
  - sizes {String} image sizes attribute
  - loading {String} 'lazy' (default) | 'eager'
  - alt {String}
  - decor {String} 'botanical' (default: leaf branch + sparkles) | 'playful' (sparkles + squiggle) | 'minimal'
{%- endcomment -%}
{%- liquid
  assign art_shape = shape | default: 'arch'
  assign art_size = size | default: 'lg'
  assign art_loading = loading | default: 'lazy'
  assign art_sizes = sizes | default: '(min-width: 992px) 520px, 90vw'
  assign art_alt = alt | default: image.alt | default: word | escape
  assign art_decor = decor | default: 'botanical'
  assign art_uid = 'mcArt' | append: section.id | append: forloop.index | append: art_shape | handleize
-%}
<div class="mc-art mc-art--{{ art_shape }} mc-art--{{ art_size }}" data-mc-art>
  {%- if word != blank -%}
    <span class="mc-art__word" aria-hidden="true" data-depth="0.15">{{ word | escape }}</span>
  {%- endif -%}
  <span class="mc-art__blob" aria-hidden="true" data-depth="0.35"></span>
  <span class="mc-art__dots" aria-hidden="true" data-depth="0.55"></span>
  {%- case art_decor -%}
    {%- when 'botanical' -%}
      <span class="mc-art__decor mc-art__decor--branch" data-depth="0.3">{% render 'mc-decor', name: 'leaves' %}</span>
      <span class="mc-art__decor mc-art__decor--spark" data-depth="0.65">{% render 'mc-decor', name: 'sparkles' %}</span>
    {%- when 'playful' -%}
      <span class="mc-art__decor mc-art__decor--spark" data-depth="0.65">{% render 'mc-decor', name: 'sparkles' %}</span>
      <span class="mc-art__decor mc-art__decor--wave" data-depth="0.4">{% render 'mc-decor', name: 'squiggle' %}</span>
  {%- endcase -%}
  <span class="mc-art__outline" aria-hidden="true" data-depth="0.25"></span>
  <div class="mc-art__frame" data-depth="0.08">
    {%- if image != blank -%}
      {{ image | image_url: width: 1200 | image_tag: widths: '360, 540, 720, 960, 1200', sizes: art_sizes, loading: art_loading, class: 'mc-art__img', alt: art_alt }}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'mc-art__img mc-art__img--placeholder' }}
    {%- endif -%}
  </div>
  {%- if caption != blank -%}
    <span class="mc-art__caption" data-depth="0.2">{{ caption | escape }}</span>
  {%- endif -%}
  {%- if sticker != blank -%}
    <span class="mc-art__sticker" data-depth="0.6">{{ sticker | escape }}</span>
  {%- endif -%}
  {%- if badge != blank -%}
    {%- capture badge_inner -%}
      <svg class="mc-art__badge-ring" viewBox="0 0 120 120" aria-hidden="true">
        <defs><path id="{{ art_uid }}" d="M60,60 m-46,0 a46,46 0 1,1 92,0 a46,46 0 1,1 -92,0"/></defs>
        <text><textPath href="#{{ art_uid }}" textLength="285">{{ badge | upcase | escape }}</textPath></text>
      </svg>
      <span class="mc-art__badge-core" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M7 17 17 7M9 7h8v8"/></svg>
      </span>
    {%- endcapture -%}
    {%- if badge_url != blank -%}
      <a class="mc-art__badge" href="{{ badge_url }}" data-depth="0.7" aria-label="{{ badge | escape }}">{{ badge_inner }}</a>
    {%- else -%}
      <span class="mc-art__badge" data-depth="0.7">{{ badge_inner }}</span>
    {%- endif -%}
  {%- endif -%}
</div>
