{%- comment -%}
  Merci vector decor — line illustrations drawn for this theme (stroke = currentColor,
  so every piece follows the accent colour). Used as extra layers in banners and tiles.
  Accepts: name {String} leaves | sparkles | squiggle | scribble | arches | leaf ; class {String}
{%- endcomment -%}
{%- liquid
  case name
    when 'leaves'
      assign vb = '0 0 160 220'
      assign sw = '1.2'
    when 'sparkles'
      assign vb = '0 0 120 120'
      assign sw = '1.3'
    when 'squiggle'
      assign vb = '0 0 220 40'
      assign sw = '1.6'
    when 'scribble'
      assign vb = '0 0 200 120'
      assign sw = '1.4'
    when 'arches'
      assign vb = '0 0 200 200'
      assign sw = '1'
    else
      assign vb = '0 0 120 160'
      assign sw = '1.2'
  endcase
-%}
<svg class="mc-decor mc-decor--{{ name }} {{ class }}" viewBox="{{ vb }}" stroke-width="{{ sw }}" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
  {%- case name -%}
    {%- when 'leaves' -%}
      <path d="M80 214C78 160 82 104 104 30"/>
      <path d="M86 168c-22-6-40-24-44-50 24 4 40 22 44 50Z"/>
      <path d="M90 130c18-10 30-30 30-54-20 10-30 30-30 54Z"/>
      <path d="M95 96c-18-6-30-22-32-42 18 4 30 20 32 42Z"/>
      <path d="M100 62c12-8 20-22 20-38-14 8-20 22-20 38Z"/>
      <path d="M84 190c16-4 30-16 36-34-18 2-30 16-36 34Z"/>
      <path d="M64 124l24 18M104 56l10-12M60 150l20 10"/>
    {%- when 'sparkles' -%}
      <path d="M40 10c2 18 10 26 28 28-18 2-26 10-28 28-2-18-10-26-28-28 18-2 26-10 28-28Z"/>
      <path d="M92 58c1 10 6 15 16 16-10 1-15 6-16 16-1-10-6-15-16-16 10-1 15-6 16-16Z"/>
      <path d="M58 90c1 6 4 9 10 10-6 1-9 4-10 10-1-6-4-9-10-10 6-1 9-4 10-10Z"/>
    {%- when 'squiggle' -%}
      <path d="M4 22c14-16 26-16 38 0s26 16 38 0 26-16 38 0 26 16 38 0 26-16 38 0 18 10 22 8"/>
    {%- when 'scribble' -%}
      <path d="M150 20C110 4 40 8 18 40c-22 32 30 66 92 66 54 0 86-26 74-56-10-26-60-38-112-30"/>
    {%- when 'arches' -%}
      <path d="M20 200V100a80 80 0 0 1 160 0v100"/>
      <path d="M40 200V100a60 60 0 0 1 120 0v100"/>
      <path d="M60 200V100a40 40 0 0 1 80 0v100"/>
    {%- else -%}
      <path d="M60 156C58 110 62 60 74 8"/>
      <path d="M62 120C30 110 14 80 20 46c30 12 44 40 42 74Z"/>
      <path d="M66 90c26-12 40-38 34-70-24 14-36 40-34 70Z"/>
  {%- endcase -%}
</svg>
