{%- comment -%}
  Currency selector (header middle / top bar / mobile drawer): flag + code + chevron.
  The list is the store's real markets — `localization.available_countries`, one entry per currency —
  and picking one submits Shopify's localization form (country_code), which switches the market and
  the prices. A currency only shows up once it is enabled for a market (Settings → Markets).
  The header setting "Currency options" (CODE:COUNTRY pairs, e.g. "EUR:DE") only chooses which
  country's flag stands for a currency shared by several countries.
  With a single currency the selector is a plain label (nothing to switch).
  Accepts:
  - section {Object} the header section
  - list_id {String} unique id for the option list (default: HeaderTopCurrencyList)
{%- endcomment -%}

{%- liquid
  assign list_id = list_id | default: 'HeaderTopCurrencyList'
  assign current_currency = localization.country.currency.iso_code | default: cart.currency.iso_code
  assign pairs = section.settings.currency_options | default: '' | split: ','

  # one country per currency: the preferred country from the setting first, then the first one found
  assign picked = ''
  assign seen = '|'
  for pair in pairs
    assign parts = pair | strip | split: ':'
    assign want_code = parts[0] | strip | upcase
    assign want_country = parts[1] | strip | upcase
    for c in localization.available_countries
      assign key = '|' | append: c.currency.iso_code | append: '|'
      if c.iso_code == want_country and c.currency.iso_code == want_code
        unless seen contains key
          assign picked = picked | append: c.iso_code | append: ','
          assign seen = seen | append: c.currency.iso_code | append: '|'
        endunless
      endif
    endfor
  endfor
  for c in localization.available_countries
    assign key = '|' | append: c.currency.iso_code | append: '|'
    unless seen contains key
      assign picked = picked | append: c.iso_code | append: ','
      assign seen = seen | append: c.currency.iso_code | append: '|'
    endunless
  endfor
  assign picked_codes = picked | split: ','

  # the flag next to the current currency: the current country, or the preferred one for that currency
  assign current_country = localization.country
  for c in localization.available_countries
    if picked_codes contains c.iso_code and c.currency.iso_code == current_currency
      assign current_country = c
    endif
  endfor
  if localization.country.currency.iso_code == current_currency
    assign current_country = localization.country
  endif

  # Display-only converter: the store has a single currency (no Shopify Payments / markets) →
  # prices are shown converted with Shopify's public rates, checkout stays in the store currency.
  assign converter_codes = ''
  if picked_codes.size < 2 and section.settings.currency_converter
    assign converter_codes = section.settings.converter_currencies | default: '' | upcase | remove: ' ' | split: ','
  endif
-%}

<header-top-dropdown class="header-top-currency{% if picked_codes.size < 2 and converter_codes.size < 2 %} header-top-currency--single{% endif %}">
  <div class="header-top__disclosure header-top-currency__disclosure">
    {%- capture current_label -%}
      {{- current_country | image_url: width: 36 | image_tag: class: 'header-top__flag', alt: '', width: 18, height: 12, loading: 'lazy' -}}
      <span class="visually-hidden">{{ 'localization.currency_label' | t }}: </span>
      <span class="header-top__selector-label">{{ current_currency }}</span>
    {%- endcapture -%}

    {%- if picked_codes.size < 2 and converter_codes.size > 1 -%}
      {%- liquid
        assign shop_currency = cart.currency.iso_code
        assign note = section.settings.converter_note | default: 'Prices in [currency] are estimates. You pay in [shop_currency] at checkout.' | replace: '[shop_currency]', shop_currency
      -%}
      <button
        type="button"
        class="header-top__selector header-top-currency__selector"
        data-dropdown-toggle
        aria-expanded="false"
        aria-controls="{{ list_id }}"
      >
        {{- current_country | image_url: width: 36 | image_tag: class: 'header-top__flag', alt: '', width: 18, height: 12, loading: 'lazy' -}}
        <span class="visually-hidden">{{ 'localization.currency_label' | t }}: </span>
        <span class="header-top__selector-label" data-converter-label>{{ shop_currency }}</span>
        <span class="header-top__chevron" aria-hidden="true">
          {% render 'icon-caret' %}
        </span>
      </button>

      <div
        class="disclosure__list-wrapper header-top__dropdown header-top-currency__dropdown"
        data-dropdown-panel
        data-currency-converter
        data-shop-currency="{{ shop_currency }}"
        data-money-format="{{ shop.money_format | strip_html | escape }}"
        data-note="{{ note | escape }}"
        hidden
      >
        <ul id="{{ list_id }}" role="list" class="disclosure__list list-unstyled">
          {%- for code in converter_codes -%}
            {%- liquid
              assign flag_country = ''
              for pair in pairs
                assign parts = pair | strip | split: ':'
                assign pair_code = parts[0] | strip | upcase
                if pair_code == code
                  assign flag_country = parts[1] | strip | downcase
                endif
              endfor
              if flag_country == blank
                assign flag_country = code | slice: 0, 2 | downcase
              endif
              if code == shop_currency
                assign flag_country = current_country.iso_code | downcase
              endif
            -%}
            <li class="disclosure__item">
              <button
                type="button"
                class="link disclosure__link focus-inset header-top-currency__option"
                data-convert-to="{{ code }}"
                {% if flag_country != blank %}data-flag="https://cdn.shopify.com/static/images/flags/{{ flag_country }}.svg?width=36"{% endif %}
                {% if code == shop_currency %}aria-current="true"{% endif %}
              >
                {%- if flag_country != blank -%}
                  <img class="header-top__flag" src="https://cdn.shopify.com/static/images/flags/{{ flag_country }}.svg?width=36" alt="" width="18" height="12" loading="lazy">
                {%- endif -%}
                <span class="header-top-currency__code">{{ code }}</span>
              </button>
            </li>
          {%- endfor -%}
        </ul>
        <p class="header-top-currency__note" data-converter-note hidden></p>
      </div>
    {%- elsif picked_codes.size < 2 -%}
      <span class="header-top__selector header-top-currency__selector">{{ current_label }}</span>
    {%- else -%}
      <button
        type="button"
        class="header-top__selector header-top-currency__selector"
        data-dropdown-toggle
        aria-expanded="false"
        aria-controls="{{ list_id }}"
      >
        {{ current_label }}
        <span class="header-top__chevron" aria-hidden="true">
          {% render 'icon-caret' %}
        </span>
      </button>

      <div
        class="disclosure__list-wrapper header-top__dropdown header-top-currency__dropdown"
        data-dropdown-panel
        hidden
      >
        {%- assign form_id = list_id | append: '-form' -%}
        {%- form 'localization', id: form_id, class: 'header-top-currency__form' -%}
          <input type="hidden" name="return_to" value="{{ request.path }}">
          <ul id="{{ list_id }}" role="list" class="disclosure__list list-unstyled">
            {%- for c in localization.available_countries -%}
              {%- if picked_codes contains c.iso_code -%}
                <li class="disclosure__item">
                  <button
                    type="submit"
                    name="country_code"
                    value="{{ c.iso_code }}"
                    class="link disclosure__link focus-inset header-top-currency__option"
                    {% if c.currency.iso_code == current_currency %}
                      aria-current="true"
                    {% endif %}
                  >
                    {{- c | image_url: width: 36 | image_tag: class: 'header-top__flag', alt: '', width: 18, height: 12, loading: 'lazy' -}}
                    <span class="header-top-currency__code">{{ c.currency.iso_code }}</span>
                    <span class="header-top-currency__symbol">{{ c.currency.symbol }}</span>
                  </button>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endform -%}
      </div>
    {%- endif -%}
  </div>
</header-top-dropdown>
