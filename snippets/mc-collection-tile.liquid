{%- comment -%}
  One tile of the Merci collections list. Accepts: c {Collection}, index {Number}, show_count {Boolean},
  image_source {String} 'product' (first product's image, default) | 'collection' (collection image)
{%- endcomment -%}
{%- liquid
  if image_source == 'collection'
    assign tile_image = c.image | default: c.featured_image
  else
    assign tile_image = c.products.first.featured_image | default: c.image
  endif
  assign num = index | prepend: '0' | slice: -2, 2
  if index > 99
    assign num = index
  endif
-%}
<li class="mc-ctile mc-hover{% unless image_source == 'collection' %} mc-ctile--packshot{% endunless %}">
  <a href="{{ c.url }}" class="mc-ctile__link">
    {%- unless image_source == 'collection' -%}
      <span class="mc-ctile__decor" aria-hidden="true">
        {%- render 'mc-decor', name: 'arches', class: 'mc-ctile__arches' -%}
        {%- render 'mc-decor', name: 'sparkles', class: 'mc-ctile__spark' -%}
      </span>
    {%- endunless -%}
    <span class="mc-ctile__media mc-media mc-frame">
      {%- if tile_image != blank -%}
        {%- assign mc_alt = tile_image.alt | default: c.title | escape -%}
        {{ tile_image | image_url: width: 1000 | image_tag: widths: '360, 540, 720, 1000', sizes: '(min-width: 992px) 33vw, 50vw', loading: 'lazy', alt: mc_alt }}
      {%- else -%}
        {{ 'collection-1' | placeholder_svg_tag }}
      {%- endif -%}
    </span>
    <span class="mc-ctile__num" aria-hidden="true">{{ num }}</span>
    <span class="mc-ctile__plate">
      <span class="mc-ctile__title">{{ c.title | escape }}</span>
      {%- if show_count -%}
        <span class="mc-ctile__count">{{ 'sections.mc_collection_hero.count' | t: count: c.products_count }}</span>
      {%- endif -%}
      <span class="mc-ctile__arrow" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M7 17 17 7M9 7h8v8"/></svg>
      </span>
    </span>
  </a>
</li>
