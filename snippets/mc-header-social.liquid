{%- comment -%}
  Merci — social icons on the left of the centered header (Header → Layout "Centered logo").
  Links come from Theme settings → Social media. Renders nothing when no link is set.
{%- endcomment -%}
{%- liquid
  assign networks = 'twitter,facebook,instagram,youtube,tiktok,pinterest' | split: ','
  assign has_any = false
  for n in networks
    assign key = 'social_' | append: n | append: '_link'
    if settings[key] != blank
      assign has_any = true
    endif
  endfor
-%}
{%- if has_any -%}
  <ul class="mc-header__social list-unstyled" role="list">
    {%- for n in networks -%}
      {%- assign key = 'social_' | append: n | append: '_link' -%}
      {%- if settings[key] != blank -%}
        {%- assign label_key = 'general.social.links.' | append: n -%}
        <li>
          <a class="mc-header__social-link" href="{{ settings[key] }}" target="_blank" rel="noopener" aria-label="{{ label_key | t }}">
            {%- case n -%}
              {%- when 'twitter' -%}{% render 'icon-twitter' %}
              {%- when 'facebook' -%}{% render 'icon-facebook' %}
              {%- when 'instagram' -%}{% render 'icon-instagram' %}
              {%- when 'youtube' -%}{% render 'icon-youtube' %}
              {%- when 'tiktok' -%}{% render 'icon-tiktok' %}
              {%- when 'pinterest' -%}{% render 'icon-pinterest' %}
            {%- endcase -%}
          </a>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
{%- endif -%}
