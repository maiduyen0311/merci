{%- comment -%}
  Header middle — logo block
  Accepts: section {Object}
{%- endcomment -%}

{%- liquid
  assign logo_top = section.settings.logo_text_top | default: shop.name
  assign logo_bottom = section.settings.logo_text_bottom
-%}

<div class="header-middle__logo">
  {%- assign logo_alt_text = settings.store_display_name | default: shop.name -%}
  <a href="{{ routes.root_url }}" class="header-middle__logo-link" aria-label="{{ settings.store_display_name | default: shop.name | escape }}">
    {%- if section.settings.logo_image != blank -%}
      {{
        section.settings.logo_image
        | image_url: width: 240
        | image_tag:
          class: 'header-middle__logo-image',
          widths: '120, 180, 240',
          alt: logo_alt_text,
          loading: 'eager'
      }}
    {%- else -%}
      <span class="header-middle__logo-text">
          <span class="header-middle__logo-top">{{ logo_top }}</span>
          {%- if logo_bottom != blank -%}<span class="header-middle__logo-bottom">{{ logo_bottom }}</span>{%- endif -%}
        </span>
      {%- endif -%}
  </a>
</div>
