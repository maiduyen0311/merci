{%- comment -%}
  Merci — Shoppable video reels (user 2026-11-26, "Nhóm 2 #5").
  DEMO-ONLY: shown on merci-demo, NOT shipped in the ThemeForest package (sold as customization) —
  see .claude/memory/packaging-scope.md. Own files only: this section,
  common/js/modules/mc-video-reels.js, common/scss/section/_mc-video-reels.scss.

  A carousel of short portrait clips (muted, play while on screen). Each card shows its first
  product; "Shop" (or a click on the clip) opens the viewer: the clip large with sound, prev / next,
  and the tagged products with variant select + add to cart.
{%- endcomment -%}
{%- style -%}
  #McReels-{{ section.id }} {
    --mc-pt: {{ section.settings.padding_top }}px;
    --mc-pb: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section
  id="McReels-{{ section.id }}"
  class="mc-section mc-reels"
  data-video-reels
  data-autoplay="{{ section.settings.autoplay }}"
  data-money-format="{{ shop.money_format | strip_html | escape }}"
>
  <div class="container">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="mc-heading">
        {%- if section.settings.eyebrow != blank -%}<span class="mc-heading__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="mc-heading__title">{{ section.settings.heading }}</h2>{%- endif -%}
      </div>
    {%- endif -%}
    {%- if section.settings.text != blank -%}<div class="mc-reels__text">{{ section.settings.text }}</div>{%- endif -%}

    <tm-scroller
      class="tm-scroller mc-scroller mc-reels__scroller"
      data-step="page"
      style="--per-view: {{ section.settings.columns_desktop }}; --per-view-md: 3; --per-view-sm: {{ section.settings.columns_mobile }}; --gap: 2rem;"
    >
      {% render 'tm-scroller-nav', class: 'mc-products__nav' %}
      <ul class="tm-scroller__track mc-reels__list" role="list" data-scroller-track>
        {%- for block in section.blocks -%}
          {%- liquid
            assign first = block.settings.products | first
            assign label = block.settings.caption | default: section.settings.heading | strip_html | escape
          -%}
          <li class="mc-reels__item" data-reel="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            <article class="mc-reel">
              <button type="button" class="mc-reel__open" data-reel-open aria-label="{{ section.settings.shop_label | escape }}: {{ label }}">
                <span class="mc-reel__media">
                  {%- if block.settings.video != blank -%}
                    {{ block.settings.video | video_tag: muted: true, loop: true, playsinline: true, preload: 'none', controls: false, image_size: '540x', class: 'mc-reel__video' }}
                  {%- elsif block.settings.video_url != blank -%}
                    <video class="mc-reel__video" src="{{ block.settings.video_url | escape }}" muted loop playsinline preload="metadata"></video>
                  {%- else -%}
                    {{ 'lifestyle-2' | placeholder_svg_tag: 'mc-reel__video placeholder-svg' }}
                  {%- endif -%}
                </span>
                <span class="mc-reel__play" aria-hidden="true">
                  <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor"><path d="M4 2.5v11l9-5.5z"/></svg>
                </span>
                {%- if block.settings.caption != blank -%}<span class="mc-reel__caption">{{ block.settings.caption }}</span>{%- endif -%}
              </button>

              {%- if first != blank -%}
                <div class="mc-reel__product">
                  {%- if first.featured_image -%}
                    {{ first.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '', class: 'mc-reel__thumb', width: 44, height: 55 }}
                  {%- endif -%}
                  <span class="mc-reel__info">
                    <a href="{{ first.url }}" class="mc-reel__name">{{ first.title }}</a>
                    <span class="mc-reel__price">{{ first.price | money }}</span>
                  </span>
                  <button type="button" class="mc-reel__shop" data-reel-open aria-label="{{ section.settings.shop_label | escape }}: {{ label }}">
                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" aria-hidden="true"><path d="M5 8h14l-1.2 12H6.2z"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8"/></svg>
                    {%- if block.settings.products.size > 1 %}<span class="mc-reel__count" aria-hidden="true">{{ block.settings.products.size }}</span>{% endif -%}
                  </button>
                </div>
              {%- endif -%}

              {%- comment -%} viewer panel for this reel — copied into the dialog by JS {%- endcomment -%}
              <template data-reel-panel>
                {%- if block.settings.caption != blank -%}<p class="mc-reels-viewer__caption">{{ block.settings.caption }}</p>{%- endif -%}
                <ul class="mc-reels-viewer__list" role="list">
                  {%- for p in block.settings.products -%}
                    {%- assign v = p.selected_or_first_available_variant -%}
                    <li class="mc-reels-viewer__item">
                      <a href="{{ p.url }}" class="mc-reels-viewer__thumb" tabindex="-1" aria-hidden="true">
                        {%- if p.featured_image -%}{{ p.featured_image | image_url: width: 180 | image_tag: loading: 'lazy', alt: '', width: 72, height: 90 }}{%- endif -%}
                      </a>
                      <span class="mc-reels-viewer__info">
                        <a href="{{ p.url }}" class="mc-reels-viewer__name">{{ p.title }}</a>
                        <span class="mc-reels-viewer__price" data-reel-price>{{ v.price | money }}</span>
                        {%- if p.has_only_default_variant == false and p.available -%}
                          <select class="mc-reels-viewer__select" data-reel-variant aria-label="{{ p.title | escape }}">
                            {%- for variant in p.variants -%}
                              <option value="{{ variant.id }}" data-price="{{ variant.price }}"{% unless variant.available %} disabled{% endunless %}{% if variant.id == v.id %} selected{% endif %}>
                                {{- variant.title -}}
                                {%- unless variant.available %} — {{ 'products.product.sold_out' | t }}{% endunless -%}
                              </option>
                            {%- endfor -%}
                          </select>
                        {%- endif -%}
                      </span>
                      {%- if p.available -%}
                        <button type="button" class="mc-reels-viewer__add" data-reel-add="{{ v.id }}">{{ 'products.product.add_to_cart' | t }}</button>
                      {%- else -%}
                        <span class="mc-reels-viewer__soldout">{{ 'products.product.sold_out' | t }}</span>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
              </template>
            </article>
          </li>
        {%- endfor -%}
      </ul>
      <div class="mc-scroller__progress" aria-hidden="true"></div>
    </tm-scroller>
  </div>

  <dialog class="mc-reels-viewer" aria-label="{{ section.settings.viewer_heading | escape }}" data-reel-viewer>
    <div class="mc-reels-viewer__inner">
      <div class="mc-reels-viewer__stage">
        <div class="mc-reels-viewer__video" data-reel-stage></div>
        <button type="button" class="mc-reels-viewer__sound" data-reel-sound aria-pressed="false" aria-label="{{ section.settings.sound_label | escape }}">
          <svg class="is-off" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 9h4l5-4v14l-5-4H4z"/><path d="m17 9 4 6M21 9l-4 6"/></svg>
          <svg class="is-on" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 9h4l5-4v14l-5-4H4z"/><path d="M17 8.5a5 5 0 0 1 0 7M19.5 6a8.5 8.5 0 0 1 0 12"/></svg>
        </button>
        <button type="button" class="mc-reels-viewer__nav mc-reels-viewer__nav--prev" data-reel-prev aria-label="{{ 'general.slider.previous_slide' | t }}">
          <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M10 3 5 8l5 5"/></svg>
        </button>
        <button type="button" class="mc-reels-viewer__nav mc-reels-viewer__nav--next" data-reel-next aria-label="{{ 'general.slider.next_slide' | t }}">
          <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m6 3 5 5-5 5"/></svg>
        </button>
        <span class="mc-reels-viewer__bar" aria-hidden="true"><span data-reel-progress></span></span>
      </div>
      <div class="mc-reels-viewer__panel">
        <h2 class="mc-reels-viewer__title">{{ section.settings.viewer_heading }}</h2>
        <div data-reel-products></div>
      </div>
      <button type="button" class="mc-reels-viewer__close" data-reel-close aria-label="{{ 'accessibility.close' | t }}">×</button>
    </div>
  </dialog>
</section>

{% schema %}
{
  "name": "Shoppable videos",
  "tag": "div",
  "class": "section-mc-reels",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Watch & shop" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Seen <em>on you</em>" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "range", "id": "columns_desktop", "label": "Videos per row on desktop", "min": 3, "max": 6, "step": 1, "default": 5 },
    { "type": "select", "id": "columns_mobile", "label": "Videos per row on mobile", "options": [ { "value": "1.4", "label": "1 (peek next)" }, { "value": "2", "label": "2" } ], "default": "2" },
    { "type": "checkbox", "id": "autoplay", "label": "Play videos while they are on screen", "info": "Muted. Visitors who ask for reduced motion see the cover image.", "default": true },
    { "type": "text", "id": "shop_label", "label": "Shop button", "default": "Shop" },
    { "type": "text", "id": "viewer_heading", "label": "Viewer heading", "default": "Shop this video" },
    { "type": "text", "id": "sound_label", "label": "Sound button label (screen readers)", "default": "Sound" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Video",
      "limit": 12,
      "settings": [
        { "type": "video", "id": "video", "label": "Video", "info": "Portrait 9:16, 5–15 seconds." },
        { "type": "text", "id": "video_url", "label": "Or an .mp4 link", "info": "Used when no video is uploaded." },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "product_list", "id": "products", "label": "Products in the video", "limit": 4 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shoppable videos",
      "blocks": [ { "type": "reel" }, { "type": "reel" }, { "type": "reel" }, { "type": "reel" }, { "type": "reel" } ]
    }
  ]
}
{% endschema %}
