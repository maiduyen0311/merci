{%- comment -%}
  Merci — Slideshow (SPEC §2 #1, render design/merci/sections/03-slideshow-desktop.png)
  Full-width slides: image + eyebrow + 2-line heading + pill button, text left / centre / right.
  Merci motion: cross-fade, text lines rise one after another; dash indicators + thin line arrows.
  JS: common/js/modules/carousel.js ([data-mc-slider] contract).
{%- endcomment -%}
{%- liquid
  assign slide_count = section.blocks.size
  assign first_in_main = false
  if section.index == 1
    assign first_in_main = true
  endif
-%}
{%- style -%}
  #McSlideshow-{{ section.id }} {
    --mc-slide-h: {{ section.settings.height_desktop }}px;
    --mc-slide-h-mobile: {{ section.settings.height_mobile }}px;
  }
{%- endstyle -%}

<section
  id="McSlideshow-{{ section.id }}"
  class="mc-slideshow{% if first_in_main %} mc-slideshow--first{% endif %}"
  data-mc-slider-root
  aria-roledescription="carousel"
  aria-label="{{ section.settings.accessibility_label | escape }}"
>
  <div
    class="mc-slideshow__track"
    data-mc-slider
    data-effect="{{ section.settings.effect }}"
    data-autoplay="{{ section.settings.autoplay }}"
    data-speed="{{ section.settings.autoplay_speed }}"
  >
    {%- for block in section.blocks -%}
      {%- liquid
        assign img_loading = 'lazy'
        assign img_priority = 'auto'
        if forloop.first
          assign img_loading = 'eager'
          assign img_priority = 'high'
        endif
      -%}
      <div
        class="mc-slideshow__slide mc-slideshow__slide--{{ block.settings.text_position }}{% if forloop.first %} is-active{% endif %}"
        data-mc-slide
        role="group"
        aria-roledescription="slide"
        aria-label="{{ forloop.index }} / {{ slide_count }}"
        style="--mc-slide-text: {{ block.settings.text_color }};"
        {{ block.shopify_attributes }}
      >
        <div class="mc-slideshow__media">
          {%- if block.settings.image != blank -%}
            {%- capture sizes -%}100vw{%- endcapture -%}
            {%- if block.settings.image_mobile != blank -%}
              <picture>
                <source media="(max-width: 749px)" srcset="{{ block.settings.image_mobile | image_url: width: 750 }} 750w, {{ block.settings.image_mobile | image_url: width: 1100 }} 1100w" sizes="100vw">
                {%- assign mc_alt = block.settings.image.alt | default: block.settings.heading | escape -%}
                {{ block.settings.image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 1920, 2400', sizes: sizes, loading: img_loading, fetchpriority: img_priority, class: 'mc-slideshow__img', alt: mc_alt }}
              </picture>
            {%- else -%}
              {%- assign mc_alt = block.settings.image.alt | default: block.settings.heading | escape -%}
              {{ block.settings.image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 1920, 2400', sizes: sizes, loading: img_loading, fetchpriority: img_priority, class: 'mc-slideshow__img', alt: mc_alt }}
            {%- endif -%}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'mc-slideshow__img mc-slideshow__img--placeholder' }}
          {%- endif -%}
        </div>

        <div class="mc-slideshow__content container">
          <div class="mc-slideshow__text">
            {%- if block.settings.eyebrow != blank -%}
              <p class="mc-slideshow__eyebrow"><span>{{ block.settings.eyebrow }}</span></p>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              {%- assign heading_lines = block.settings.heading | newline_to_br | split: '<br />' -%}
              <h2 class="mc-slideshow__heading">
                {%- for line in heading_lines -%}
                  <span class="mc-slideshow__line" style="--i: {{ forloop.index }};"><span>{{ line | strip }}</span></span>
                {%- endfor -%}
              </h2>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <div class="mc-slideshow__cta" style="--i: {{ heading_lines.size | default: 1 | plus: 1 }};">
                <a
                  {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% else %}role="link" aria-disabled="true"{% endif %}
                  class="mc-btn mc-btn--{{ block.settings.button_style }}"
                >
                  {{- block.settings.button_label | escape -}}
                </a>
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if slide_count > 1 -%}
    {%- if section.settings.show_arrows -%}
      <button type="button" class="mc-slideshow__arrow mc-slideshow__arrow--prev" data-mc-slider-prev aria-label="{{ 'general.slider.previous_slide' | t }}">
        <svg viewBox="0 0 40 16" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M39 8H2M8 1 1 8l7 7"/></svg>
      </button>
      <button type="button" class="mc-slideshow__arrow mc-slideshow__arrow--next" data-mc-slider-next aria-label="{{ 'general.slider.next_slide' | t }}">
        <svg viewBox="0 0 40 16" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M1 8h37M32 1l7 7-7 7"/></svg>
      </button>
    {%- endif -%}
    <div class="mc-slideshow__dots" data-mc-slider-dots></div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Merci slideshow",
  "tag": "div",
  "class": "section-mc-slideshow",
  "settings": [
    { "type": "range", "id": "height_desktop", "label": "Height on desktop", "min": 400, "max": 900, "step": 10, "unit": "px", "default": 640 },
    { "type": "range", "id": "height_mobile", "label": "Height on mobile", "min": 260, "max": 700, "step": 10, "unit": "px", "default": 440 },
    {
      "type": "select",
      "id": "effect",
      "label": "Transition",
      "options": [
        { "value": "fade", "label": "Fade" },
        { "value": "slide", "label": "Slide" }
      ],
      "default": "fade"
    },
    { "type": "checkbox", "id": "autoplay", "label": "Auto-rotate slides", "default": true },
    { "type": "range", "id": "autoplay_speed", "label": "Change slides every", "min": 3, "max": 10, "step": 1, "unit": "s", "default": 6 },
    { "type": "checkbox", "id": "show_arrows", "label": "Show arrows", "default": true },
    { "type": "text", "id": "accessibility_label", "label": "Slideshow description (screen readers)", "default": "Slideshow" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "limit": 6,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "1920 × 640 px recommended" },
        { "type": "image_picker", "id": "image_mobile", "label": "Mobile image (optional)", "info": "750 × 880 px recommended" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New arrivals" },
        { "type": "textarea", "id": "heading", "label": "Heading", "default": "Enjoy this\nsummer trend", "info": "Each line animates in on its own." },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Button link" },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "options": [
            { "value": "outline", "label": "Outline" },
            { "value": "solid", "label": "Solid" },
            { "value": "dark", "label": "Dark" }
          ],
          "default": "outline"
        },
        {
          "type": "select",
          "id": "text_position",
          "label": "Text position",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        },
        { "type": "color", "id": "text_color", "label": "Text color", "default": "#000000" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Merci slideshow",
      "blocks": [
        { "type": "slide" },
        { "type": "slide", "settings": { "eyebrow": "Hot trend summer", "heading": "Introducing our\nnew suit collection", "text_position": "right" } }
      ]
    }
  ]
}
{% endschema %}
