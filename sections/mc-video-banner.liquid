{%- comment -%}
  Merci — Video banner (SPEC §2 #3, render design/merci/sections/05-*-desktop.png)
  Two tiles (8/4 on desktop, stacked on mobile):
    • video tile: poster image + play button with a pulsing ring → YouTube / Vimeo in a popup (mc-video-popup.js)
    • image tile: picture + large letter-spaced word ("WOMAN") + link
  Hover: slow zoom + editorial inner frame.
{%- endcomment -%}
{%- liquid
  assign video = section.settings.video_url
  assign video_src = ''
  if video != blank
    if video.type == 'youtube'
      assign video_src = 'https://www.youtube.com/embed/' | append: video.id | append: '?autoplay=1&rel=0'
    elsif video.type == 'vimeo'
      assign video_src = 'https://player.vimeo.com/video/' | append: video.id | append: '?autoplay=1'
    endif
  endif
-%}
{%- style -%}
  #McVideoBanner-{{ section.id }} {
    --mc-pt: {{ section.settings.padding_top }}px;
    --mc-pb: {{ section.settings.padding_bottom }}px;
    --mc-word-color: {{ section.settings.word_color }};
  }
{%- endstyle -%}

<section id="McVideoBanner-{{ section.id }}" class="mc-section mc-video-banner">
  <div class="container">
    <div class="mc-video-banner__grid{% if section.settings.reverse %} mc-video-banner__grid--reverse{% endif %}">
      <div class="mc-video-banner__tile mc-video-banner__tile--video mc-hover">
        <div class="mc-media mc-frame mc-video-banner__media">
          {%- if section.settings.poster != blank -%}
            {%- assign mc_alt = section.settings.poster.alt | default: shop.name | escape -%}
            {{ section.settings.poster | image_url: width: 1600 | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 992px) 780px, 100vw', loading: 'lazy', alt: mc_alt }}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag }}
          {%- endif -%}
        </div>
        {%- if video_src != blank -%}
          <button
            type="button"
            class="mc-video-banner__play"
            data-mc-video-open
            data-video-src="{{ video_src }}"
            data-video-title="{{ section.settings.video_title | escape }}"
            data-close-label="{{ 'accessibility.close' | t }}"
            aria-label="{{ 'sections.video.load_video' | t: description: section.settings.video_title | escape }}"
          >
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor"/></svg>
          </button>
        {%- endif -%}
      </div>

      <div class="mc-video-banner__tile mc-video-banner__tile--image mc-hover">
        {%- if section.settings.banner_link != blank -%}<a href="{{ section.settings.banner_link }}" class="mc-video-banner__link">{%- endif -%}
          <div class="mc-media mc-frame mc-video-banner__media">
            {%- if section.settings.banner_image != blank -%}
              {%- assign mc_alt = section.settings.banner_image.alt | default: section.settings.banner_word | default: shop.name | escape -%}
              {{ section.settings.banner_image | image_url: width: 900 | image_tag: widths: '400, 600, 900', sizes: '(min-width: 992px) 380px, 100vw', loading: 'lazy', alt: mc_alt }}
            {%- else -%}
              {{ 'product-apparel-1' | placeholder_svg_tag }}
            {%- endif -%}
          </div>
          {%- if section.settings.banner_word != blank -%}
            <span class="mc-video-banner__word">{{ section.settings.banner_word | escape }}</span>
          {%- endif -%}
        {%- if section.settings.banner_link != blank -%}</a>{%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Merci video banner",
  "tag": "div",
  "class": "section-mc-video-banner",
  "settings": [
    { "type": "header", "content": "Video" },
    { "type": "image_picker", "id": "poster", "label": "Cover image", "info": "780 × 400 px recommended" },
    { "type": "video_url", "id": "video_url", "label": "YouTube or Vimeo URL", "accept": ["youtube", "vimeo"], "default": "https://www.youtube.com/watch?v=_9VUPq3SxOc" },
    { "type": "text", "id": "video_title", "label": "Video title (screen readers)", "default": "Merci summer lookbook" },
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "banner_image", "label": "Image", "info": "380 × 400 px recommended" },
    { "type": "text", "id": "banner_word", "label": "Word over the image", "default": "Woman" },
    { "type": "color", "id": "word_color", "label": "Word color", "default": "#a6606d" },
    { "type": "url", "id": "banner_link", "label": "Link" },
    { "type": "header", "content": "Layout" },
    { "type": "checkbox", "id": "reverse", "label": "Image first, video second", "default": false },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 }
  ],
  "presets": [{ "name": "Merci video banner" }]
}
{% endschema %}
