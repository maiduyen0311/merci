{%- comment -%}
  Merci — Text columns (SPEC §2 #2, render design/merci/sections/04-*-desktop.png)
  Bordered boxes: uppercase heading + small sub-line. Hover: border turns primary, sub-line underline grows.
  Mobile: swipe row (tm-scroller).
{%- endcomment -%}
{%- style -%}
  #McTextColumns-{{ section.id }} { --mc-pt: {{ section.settings.padding_top }}px; --mc-pb: {{ section.settings.padding_bottom }}px; }
{%- endstyle -%}

<section id="McTextColumns-{{ section.id }}" class="mc-section mc-text-columns">
  <div class="container">
    <tm-scroller class="tm-scroller mc-scroller" style="--per-view: {{ section.blocks.size | at_least: 1 }}; --per-view-md: {{ section.blocks.size | at_most: 3 }}; --per-view-sm: 1.15; --gap: 3rem;">
      <ul class="tm-scroller__track mc-text-columns__list" role="list" data-scroller-track>
        {%- for block in section.blocks -%}
          <li class="mc-text-columns__item mc-hover" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="mc-text-columns__box">{%- else -%}<div class="mc-text-columns__box">{%- endif -%}
              {%- if block.settings.heading != blank -%}
                <h3 class="mc-text-columns__heading">{{ block.settings.heading }}</h3>
              {%- endif -%}
              {%- if block.settings.subheading != blank -%}
                <span class="mc-text-columns__sub"><span class="mc-link">{{ block.settings.subheading }}</span></span>
              {%- endif -%}
            {%- if block.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </tm-scroller>
  </div>
</section>

{% schema %}
{
  "name": "Merci text columns",
  "tag": "div",
  "class": "section-mc-text-columns",
  "settings": [
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "limit": 4,
      "settings": [
        { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "New styles have landed" },
        { "type": "inline_richtext", "id": "subheading", "label": "Sub-line", "default": "Get ready to shop" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Merci text columns",
      "blocks": [
        { "type": "column" },
        { "type": "column", "settings": { "heading": "Why not visit us in store?", "subheading": "Take me there" } },
        { "type": "column", "settings": { "heading": "Buy now, pay later", "subheading": "Find out more" } }
      ]
    }
  ]
}
{% endschema %}
