{%- comment -%}
  Merci — Blog posts (SPEC §2 #9, render design/merci/sections/11-*-desktop.png)
  Cards: image 4:3 (zoom + frame on hover) · date (muted, uppercase) · title with growing underline.
  Mobile: swipe row with progress bar.
{%- endcomment -%}
{%- liquid
  assign blog = section.settings.blog
  assign limit = section.settings.posts_to_show
  assign cols = section.settings.columns_desktop
-%}
{%- style -%}
  #McBlogPosts-{{ section.id }} { --mc-pt: {{ section.settings.padding_top }}px; --mc-pb: {{ section.settings.padding_bottom }}px; }
{%- endstyle -%}

<section id="McBlogPosts-{{ section.id }}" class="mc-section mc-blog-posts">
  <div class="container">
    {%- if section.settings.title != blank -%}
      <div class="mc-heading"><h2 class="mc-heading__title">{{ section.settings.title }}</h2></div>
    {%- endif -%}

    <tm-scroller class="tm-scroller mc-scroller" style="--per-view: {{ cols }}; --per-view-md: 2; --per-view-sm: 1.2; --gap: 3rem; --nav-top: 30%;">
      <ul class="tm-scroller__track mc-blog-posts__list" role="list" data-scroller-track>
        {%- if blog != blank and blog.articles_count > 0 -%}
          {%- for article in blog.articles limit: limit -%}
            <li class="mc-blog-posts__item">
              <article class="mc-blog-card mc-hover">
                <a href="{{ article.url }}" class="mc-media mc-frame mc-blog-card__media" tabindex="-1" aria-hidden="true">
                  {%- if article.image != blank -%}
                    {{ article.image | image_url: width: 800 | image_tag: widths: '400, 600, 800', sizes: '(min-width: 992px) 370px, (min-width: 750px) 50vw, 85vw', loading: 'lazy', alt: article.image.alt | default: article.title | escape }}
                  {%- else -%}
                    {{ 'lifestyle-1' | placeholder_svg_tag }}
                  {%- endif -%}
                </a>
                <div class="mc-blog-card__body">
                  {%- if section.settings.show_date -%}
                    <time class="mc-blog-card__meta" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | time_tag: format: 'date' }}</time>
                  {%- endif -%}
                  <h3 class="mc-blog-card__title"><a href="{{ article.url }}" class="mc-link">{{ article.title | escape }}</a></h3>
                  {%- if section.settings.show_excerpt -%}
                    <p class="mc-blog-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 18 }}</p>
                  {%- endif -%}
                </div>
              </article>
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..limit) -%}
            <li class="mc-blog-posts__item">
              <article class="mc-blog-card">
                <div class="mc-media mc-blog-card__media">{{ 'lifestyle-2' | placeholder_svg_tag }}</div>
                <div class="mc-blog-card__body">
                  <span class="mc-blog-card__meta">{{ 'now' | date: '%B %d, %Y' }}</span>
                  <h3 class="mc-blog-card__title">{{ 'onboarding.blog_title' | t }}</h3>
                </div>
              </article>
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
      <div class="mc-scroller__progress" aria-hidden="true"></div>
    </tm-scroller>
  </div>
</section>

{% schema %}
{
  "name": "Merci blog posts",
  "tag": "div",
  "class": "section-mc-blog-posts",
  "settings": [
    { "type": "inline_richtext", "id": "title", "label": "Heading", "default": "Latest blogs" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "posts_to_show", "label": "Posts to show", "min": 2, "max": 9, "step": 1, "default": 3 },
    { "type": "range", "id": "columns_desktop", "label": "Posts per row on desktop", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "checkbox", "id": "show_date", "label": "Show date", "default": true },
    { "type": "checkbox", "id": "show_excerpt", "label": "Show excerpt", "default": false },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 }
  ],
  "presets": [{ "name": "Merci blog posts" }]
}
{% endschema %}
