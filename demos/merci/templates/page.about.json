    "story": {
      "type": "mc-story",
      "settings": {
        "chapter": "01 — Our story",
        "heading": "A small shop with a <em>slow</em> wardrobe",
        "text": "<p>Merci started in a tiny studio with one rail of clothes and a simple idea: fewer, better pieces that feel good from the first wear and still look right years later.</p><p>Today we work with a handful of family-run workshops. We visit them, we know the people who cut and sew our clothes, and we pay for the time good work takes.</p><p>Every style is tried on, washed and worn by our team before it joins the collection.</p>",
        "reverse": false,
        "quote": "Clothes should make life easier, not louder. That is the whole brief.",
        "author": "Anna Merci",
        "role": "Founder",
        "image": "shopify://shop_images/merci-demo-art-knit.jpg",
        "word": "Story",
        "badge": "Since 2020 • Merci studio • ",
        "padding_top": 88,
